# ── Server (never exposed to the browser) ──────────────────────────────
# Postgres connection string. Any provider works (Neon, Supabase, local).
DATABASE_URL=postgresql://user:password@localhost:5432/stakevote

# Polygon Amoy JSON-RPC endpoint (e.g. from Alchemy/Infura or the public RPC).
RPC_URL=https://rpc-amoy.polygon.technology

# Private key of the chairperson wallet. Deploys governance contracts and
# runs lifecycle transactions. Needs Amoy test POL for gas.
ADMIN_PRIVATE_KEY=

# Basic Auth password for the /admin panel (username is always `admin`).
ADMIN_PASSWORD=

# ── Client (inlined into the browser bundle) ────────────────────────────
# Chain the voter UI expects. 80002 = Polygon Amoy.
NEXT_PUBLIC_CHAIN_ID=80002
